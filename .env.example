# Copy this file to .env and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: public URL used by the "Download App" button on the home page.
# Falls back to the local /download redirect (see public/_redirects) when empty.
VITE_PYLO_DOWNLOAD_URL=
